# Sonix — Root Environment Configuration Index
#
# This project ships with TWO separate, ready-to-use .env.example files.
# Copy the relevant one to `.env` and fill in your own values before running.
#
#   1. Backend (Laravel API):  laravel-backend/.env.example
#   2. Mobile  (Expo app):     expo-app/.env.example
#
# ---------------------------------------------------------------------------
# Quick reference — the values you will need to set in each file:
# ---------------------------------------------------------------------------
#
# laravel-backend/.env
#   APP_URL=https://yourdomain.com
#   DB_CONNECTION=pgsql          # or mysql
#   DB_DATABASE=sonix
#   DB_USERNAME=postgres
#   DB_PASSWORD=************     # your database password
#   REDIS_HOST=127.0.0.1
#   REVERB_APP_ID=               # from `php artisan reverb:install`
#   REVERB_APP_KEY=
#   REVERB_APP_SECRET=
#   CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#   EXPO_ACCESS_TOKEN=           # from https://expo.dev
#
# expo-app/.env
#   EXPO_PUBLIC_API_URL=https://your-api-domain.com/api
#
# NEVER commit a real .env file. All secrets above are placeholders.
